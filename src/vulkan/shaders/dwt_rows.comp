#version 460
// SPDX-License-Identifier: MIT
// Horizontal 9/7 analysis of one row per workgroup (lifting in shared memory).
// Reads the current LL region of src, writes low|high de-interleaved rows to dst.
#include "common.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint64_t src;
    uint64_t dst;
    uint stride;       // plane width
    uint planeSize;    // width * height
    uint w, h;         // current LL extent
};

shared float row[4096];

const float ALPHA = -1.586134342059924;
const float BETA = -0.052980118572961;
const float GAMMA = 0.882911075530934;
const float DELTA = 0.443506852043971;
const float K = 1.230174104914001;

int mirror(int i, int n) {
    if (i < 0) return -i;
    if (i >= n) return 2 * (n - 1) - i;
    return i;
}

void lift(int parity, float c, int n) {
    for (int i = int(gl_LocalInvocationID.x) * 2 + parity; i < n; i += 512)
        row[i] += c * (row[mirror(i - 1, n)] + row[mirror(i + 1, n)]);
    barrier();
}

void main() {
    uint y = gl_WorkGroupID.x;
    uint comp = gl_WorkGroupID.y;
    F32Buf S = F32Buf(src);
    F32Buf D = F32Buf(dst);
    uint base = comp * planeSize + y * stride;
    int n = int(w);
    for (uint i = gl_LocalInvocationID.x; i < w; i += 256) row[i] = S.v[base + i];
    barrier();
    if (n == 1) {
        if (gl_LocalInvocationID.x == 0) D.v[base] = row[0];
        return;
    }
    lift(1, ALPHA, n);
    lift(0, BETA, n);
    lift(1, GAMMA, n);
    lift(0, DELTA, n);
    uint sn = (w + 1) / 2;
    for (uint i = gl_LocalInvocationID.x; i < w; i += 256) {
        if ((i & 1u) == 0u) D.v[base + i / 2] = row[i] * (1.0 / K);
        else D.v[base + sn + i / 2] = row[i] * K;
    }
}
